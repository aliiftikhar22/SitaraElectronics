rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Products: anyone can view the shop, only a logged-in admin can add/edit/delete.
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders: a customer can create an order and look up ONE order by its exact ID
    // (that's how "track my order" works without exposing everyone else's orders).
    // Listing all orders, changing status, or deleting requires an admin login.
    match /orders/{orderId} {
      allow get: if true;
      allow list: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
  }
}
